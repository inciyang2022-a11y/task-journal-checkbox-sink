	"description": "Manage centralized Obsidian task lists with status journals, automatic sinking, archiving, and undo.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"check:release": "node release-check.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/inciyang2022-a11y/task-journal-checkbox-sink.git"
	},
	"bugs": {
		"url": "https://github.com/inciyang2022-a11y/task-journal-checkbox-sink/issues"
	},
	"homepage": "https://github.com/inciyang2022-a11y/task-journal-checkbox-sink#readme",
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"task-management",
		"daily-notes",
		"mobile"
	],
	"author": "inciyang2022-a11y",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^3.2.4"
	}
}
